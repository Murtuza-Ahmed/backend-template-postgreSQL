# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=MyApp
APP_URL=http://localhost:4000
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_template

# ── Seed admin (npx prisma db seed) ──────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ── JWT (long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Mail (SMTP — Gmail: use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# ── OTP ──────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Frontend sends the Google ID token to POST /api/auth/google
GOOGLE_CLIENT_ID=

# ── SMS (optional — forgot-email flow falls back to server log in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Cloudinary (uploads) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for every upload — files land in <folder>/images|videos|documents
CLOUDINARY_FOLDER=app-uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=50
UPLOAD_MAX_DOC_MB=10
